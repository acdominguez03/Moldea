    "speech_to_text_description" : {
      "comment" : "Pie de la pantalla de voz. La frase entre comillas es un ejemplo de varios hábitos dictados de una vez: adáptala al idioma en vez de traducirla literalmente.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can list several habits in a single sentence: “I’ve drunk water, I’ve read, and I’ve gone for a run.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes nombrar varios hábitos en una sola frase: “He bebido agua, he leído y he corrido”."
          }
        }
      }
    },
